# Telegram Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Groq API (https://console.groq.com)
GROQ_API_KEY=

# Optional overrides
GROQ_MODEL_PRIMARY=llama-3.1-8b-instant
GROQ_MODEL_FALLBACK=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_VISION_MODEL=llava-v1.5-7b-4096-preview

DB_PATH=atlas.db
DATABASE_URL=postgresql://user:password@host:5432/database
PORT=8080
TIMEZONE=Asia/Kolkata
BRIEFING_HOUR=8
BRIEFING_MINUTE=0

# Render deployment: set to your public URL + /health
# SELF_PING_URL=https://your-app.onrender.com/health

# Google OAuth for Gmail and Calendar (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob
